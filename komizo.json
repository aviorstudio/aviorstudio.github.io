{
  "version": 1,
  "recipe": "configuration",
  "repository": "aviorstudio/aviorstudio.github.io",
  "tools": {
    "actionlint": "1.7.12"
  },
  "artifacts": [
    ".artifacts/dist"
  ],
  "stages": {
    "lint": [
      [
        "python3",
        "scripts/check.py"
      ],
      [
        "actionlint"
      ]
    ],
    "unit": {
      "inapplicable": "The redirect invariants are checked by the lint gate"
    },
    "build": [
      [
        "python3",
        "scripts/check.py",
        "--build"
      ]
    ]
  },
  "validation": {
    "workflow": {
      "required": [
        "ci.yml",
        "dependency-policy.yml"
      ],
      "ci_gates": [
        "Test"
      ]
    }
  }
}
